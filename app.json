{
  "expo": {
    "name": "Foto Swipe",
    "slug": "foto-swipe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E11",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.local.fotoswipe"
    },
    "android": {
      "package": "de.local.fotoswipe",
      "adaptiveIcon": {
        "backgroundColor": "#0E0E11",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Foto Swipe braucht Zugriff auf deine Fotos, damit du sie durchsehen und Aussortiertes löschen kannst. Nichts verlässt dein Gerät.",
          "savePhotosPermission": "Foto Swipe braucht Schreibzugriff, um aussortierte Fotos zu löschen.",
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-image"
    ]
  }
}
