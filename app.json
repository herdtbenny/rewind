{
  "expo": {
    "name": "Rewind",
    "slug": "rewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.local.rewind"
    },
    "android": {
      "package": "de.local.rewind",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Rewind braucht Zugriff auf deine Fotos und Videos, damit du sie durchsehen, Favoriten markieren und Aussortiertes löschen kannst. Nichts verlässt dein Gerät.",
          "savePhotosPermission": "Rewind braucht Schreibzugriff, um Favoriten zu setzen und Aussortiertes zu löschen.",
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      "expo-image",
      "expo-video"
    ]
  }
}
